# Apify API token (https://console.apify.com/account/integrations)
APIFY_TOKEN=

# Apify actor id for the Instagram scraper (default: apify/instagram-scraper)
APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper

# Apify actor id for the TikTok scraper (default: clockworks/free-tiktok-scraper)
APIFY_TIKTOK_ACTOR=clockworks~free-tiktok-scraper

# Native TikTok captions only, no AI speech-to-text (avoids per-minute cost).
# Set to "false" only alongside a transcribe-capable actor for subtitle-less videos.
APIFY_TIKTOK_NATIVE_SUBTITLES_ONLY=true

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini model to use for recipe parsing + macro estimation
GEMINI_MODEL=gemini-2.5-flash

# HTTP port the server listens on
PORT=3000

# Shared secret the app sends as the `x-morsel-app-key` header. When set, the
# backend rejects /extract, /improve, /image-search and /nutrition calls without
# it (lightweight guardrail against random callers running up Apify/Gemini
# spend). Must match the app's EXPO_PUBLIC_APP_KEY - if either side is empty the
# guardrail does nothing and the routes are open to anyone. Leave empty for local
# dev to disable the check deliberately; set it in every deployed environment.
APP_SHARED_SECRET=

# --- Third-party data APIs -------------------------------------------------
# These live here, not in the app: EXPO_PUBLIC_* vars are inlined into the JS
# bundle at build time and are extractable from the shipped APK.

# Pexels (https://www.pexels.com/api/) - recipe photo backfill via /image-search.
# Empty just disables backfill; recipes still save without a photo.
PEXELS_API_KEY=

# USDA FoodData Central (https://fdc.nal.usda.gov/api-key-signup.html) - the
# nutrition cross-check via /nutrition. Empty falls back to USDA's shared
# DEMO_KEY, which is rate-limited across everyone using it, so set a real one.
USDA_API_KEY=

# --- Abuse & cost controls -------------------------------------------------

# Upstash Redis REST credentials (https://console.upstash.com - free tier is
# plenty). Backs the per-IP rate limit, the per-install monthly quota and the
# extraction cache. Leave empty locally: the server falls back to an in-memory
# store that resets on every restart. Set BOTH in any deployed environment.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI extractions one install may make per calendar month. Mirrors
# FREE_AI_EXTRACTION_LIMIT in the app. Only Instagram/TikTok links count -
# web & blog imports are unlimited on every plan.
#
# This is the FREE cap. PLUS_DEVICE_EXTRACTION_LIMIT applies instead when the
# caller holds a redeemed Plus code OR is signed in with an active RevenueCat
# subscription - both read from records this server wrote (the grant in Upstash,
# the subscription in Supabase), never from a plan the client claims. Resolved in
# one place, src/lib/entitlement.ts.
MONTHLY_DEVICE_EXTRACTION_LIMIT=30

# The same allowance for an install holding an active Plus grant. Mirrors
# PLUS_AI_EXTRACTION_LIMIT in the app.
PLUS_DEVICE_EXTRACTION_LIMIT=200

# Service-wide AI extractions per day. Past this, /extract returns 503
# at_capacity for social links while web & blog links keep working.
#
# On the FREE Apify/Gemini tiers neither vendor can overspend, so this is an
# availability guard, not a bill guard: it rations a fixed monthly allowance so
# it isn't burnt in week one. Apify's free $5/mo at $2.70/1000 results (we pull
# 1 result per extraction) is ~1,850 Instagram extractions/month, i.e. ~61/day.
# 50 leaves headroom for TikTok, whose compute-unit cost draws on the same $5.
GLOBAL_DAILY_EXTRACTION_LIMIT=50

# Service-wide AI improvements per day (/improve, the AI Kitchen Assistant's
# substitutes and healthier-version generators). Past this, /improve returns 503
# at_capacity; the rest of the recipe screen is unaffected.
#
# Deliberately a separate budget from GLOBAL_DAILY_EXTRACTION_LIMIT. Both routes
# spend the same project-wide Gemini free-tier allowance, but the extraction
# ceiling is sized against Apify credit, which /improve never touches - pooling
# them would let the assistant eat an extraction budget it costs nothing towards.
#
# Sized so a full extraction day plus a full improve day still fits under
# Gemini's per-project daily request ceiling: extraction is one Gemini call per
# uncached metered link, so 50 + 150 = 200 requests/day.
GLOBAL_DAILY_IMPROVE_LIMIT=150

# Per-IP fixed-window rate limit on every protected route (/extract, /improve,
# /image-search, /nutrition, /redeem, /entitlement).
IP_RATE_LIMIT_MAX=30
IP_RATE_LIMIT_WINDOW_MS=60000

# --- Morsel Plus redeem codes ----------------------------------------------
# Codes that grant Morsel Plus for free via POST /redeem. There is no database
# here, so the issued list lives in this env var and redemption state lives in
# Upstash: adding or revoking a code is an env edit plus a redeploy.
#
# Comma-separated. Matching ignores case, spaces and hyphens, so MORSEL-PLUS-01
# and morselplus01 are the same code. Empty disables redemption entirely.
#
# ISSUE HIGH-ENTROPY CODES ONLY. The store fails open, so the 5-wrong-attempts
# -per-hour limiter in routes/redeem.ts is a speed bump, not a guarantee.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(8).toString('base64url').toUpperCase().slice(0,10))"
#
# Requires Upstash: without it, redemption state resets on every redeploy and
# every code becomes reusable. Check GET /health reports "store":"upstash".
PLUS_REDEEM_CODES=

# How long a redeemed grant lasts, in days. 0 = never expires. Applied at
# redemption time, so changing it does not affect grants already claimed.
PLUS_GRANT_DAYS=0

# How long a successful extraction is reused for the same post. Cache hits cost
# nothing and don't count against anyone's quota, so this is the main lever on
# how far the free Apify credit stretches. Entries are keyed on the post's
# canonical id (Instagram shortcode / TikTok video id), so every way a link is
# shared - ?igsh=, ?utm_source=, short links - resolves to one entry.
#
# Long by design: recipe text never goes stale and 256 MB holds ~128k recipes.
# The photo does decay (Instagram/TikTok image URLs are time-signed and expire),
# but the app backfills a Pexels image when a download fails.
EXTRACT_CACHE_TTL_DAYS=365

# --- Accounts & subscriptions (Supabase) -----------------------------------
# Optional. Leave empty and the server behaves exactly as it did before accounts
# existed: everyone is served, redeem codes still work, and nobody's purchase is
# ever seen - which means a paying subscriber gets the FREE cap. Set these in any
# environment where subscriptions are sold.
#
# Before these do anything, run server/supabase/001_subscriptions.sql in the
# Supabase SQL editor and confirm both tables report RLS enabled.

# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Public anon key. The app ships this too - it is safe ONLY because RLS is on.
# Used here to read an entitlement while presenting the caller's own JWT, so
# Postgres does the verifying and the row-scoping instead of this server.
SUPABASE_ANON_KEY=

# Service role key. BYPASSES RLS. Server-only: never prefix it EXPO_PUBLIC_,
# never put it in eas.json, never read it from app code - EXPO_PUBLIC_* vars are
# inlined into the JS bundle and are extractable from the shipped AAB. Only the
# RevenueCat webhook uses it.
SUPABASE_SERVICE_ROLE_KEY=

# --- RevenueCat ------------------------------------------------------------

# Shared secret RevenueCat sends in the Authorization header of its webhook.
# Set the SAME value in RevenueCat → Integrations → Webhooks, alongside the URL
# https://<your-server>/webhooks/revenuecat
#
# Unlike APP_SHARED_SECRET, an empty value here REJECTS EVERY DELIVERY rather
# than disabling the check. This endpoint is the only writer of paid
# entitlements, so failing open would make it a public "grant me Plus" button.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REVENUECAT_WEBHOOK_SECRET=

# The entitlement identifier that means Plus, spelled exactly as in the
# RevenueCat dashboard. Must match ENTITLEMENTS.plus in the app
# (Morsel/lib/purchases/config.ts) - a mismatch means webhooks arrive, get
# logged, and grant nobody anything.
REVENUECAT_ENTITLEMENT_ID=Morsel Plus

# RevenueCat SECRET API key (starts "sk_"). NOT CURRENTLY USED: entitlements are
# fed by the webhook above, which needs no outbound call. Kept documented because
# it is what a reconciliation path (re-fetching a subscriber when a webhook is
# missed) would need. Server-only if you ever set it.
REVENUECAT_SECRET_API_KEY=
