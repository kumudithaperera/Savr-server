# Apify API token (https://console.apify.com/account/integrations)
APIFY_TOKEN=

# Apify actor id for the Instagram scraper (default: apify/instagram-scraper)
APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini model to use for recipe parsing + macro estimation
GEMINI_MODEL=gemini-2.5-flash

# HTTP port the server listens on
PORT=3000

# RevenueCat SECRET API key (starts "sk_"), for server-side entitlement
# verification. Server-only — never expose to the app / never prefix EXPO_PUBLIC.
# Get it from RevenueCat → Project settings → API keys (secret keys).
REVENUECAT_SECRET_API_KEY=
