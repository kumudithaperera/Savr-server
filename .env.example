# Apify API token (https://console.apify.com/account/integrations)
APIFY_TOKEN=

# Apify actor id for the Instagram scraper (default: apify/instagram-scraper)
APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper

# Apify actor id for the TikTok scraper (default: clockworks/free-tiktok-scraper)
APIFY_TIKTOK_ACTOR=clockworks~free-tiktok-scraper

# Native TikTok captions only, no AI speech-to-text (avoids per-minute cost).
# Set to "false" only alongside a transcribe-capable actor for subtitle-less videos.
APIFY_TIKTOK_NATIVE_SUBTITLES_ONLY=true

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini model to use for recipe parsing + macro estimation
GEMINI_MODEL=gemini-2.5-flash

# HTTP port the server listens on
PORT=3000

# Shared secret the app sends as the `x-morsel-app-key` header. When set, the
# backend rejects /extract and /improve calls without it (lightweight guardrail
# against random callers running up Apify/Gemini spend). Must match the app's
# EXPO_PUBLIC_APP_KEY. Leave empty for local dev to disable the check.
APP_SHARED_SECRET=

# RevenueCat SECRET API key (starts "sk_"), for server-side entitlement
# verification. Server-only — never expose to the app / never prefix EXPO_PUBLIC.
# Get it from RevenueCat → Project settings → API keys (secret keys).
REVENUECAT_SECRET_API_KEY=
